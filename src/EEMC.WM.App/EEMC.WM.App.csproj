<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EEMC.WM.App</RootNamespace>
    <AssemblyName>EEMC.WorkManager</AssemblyName>
    <Product>EEMC KHCN Work Manager</Product>
    <Company>EEMC</Company>
    <Version>1.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- MVVMTK0034: một số chỗ cố ý gán trực tiếp field để không kích hoạt tải lại dữ liệu -->
    <NoWarn>$(NoWarn);MVVMTK0034;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tránh xung đột tên giữa WinForms và WPF khi bật UseWindowsForms (chỉ dùng NotifyIcon) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EEMC.WM.Core\EEMC.WM.Core.csproj" />
    <ProjectReference Include="..\EEMC.WM.Data\EEMC.WM.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
