<UserControl x:Class="EEMC.WM.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EEMC.WM.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Sem.Green}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Lưu cài đặt" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="140"/>
            </StackPanel>
            <TextBlock Text="Cài đặt" Style="{StaticResource H1}"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Giờ làm việc -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Giờ làm việc và ngày làm việc" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Periods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PeriodRow}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="70" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                            <TextBox Width="70" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                            <Button Content="Xóa" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemovePeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ Thêm khung giờ" HorizontalAlignment="Left" Command="{Binding AddPeriodCommand}"/>

                            <TextBlock Text="Ngày làm việc trong tuần" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DayRow}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,14,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Ngày nghỉ lễ / nghỉ cá nhân" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker Width="160" SelectedDate="{Binding NewHoliday}"/>
                                <Button Content="Thêm ngày nghỉ" Margin="8,0,0,0" Command="{Binding AddHolidayCommand}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Holidays}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="12" Padding="10,2,4,2" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StringFormat=dd/MM/yyyy}" VerticalAlignment="Center"/>
                                                <Button Content="✕" Style="{StaticResource GhostButton}" Padding="4,0" MinHeight="18"
                                                        Command="{Binding DataContext.RemoveHolidayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Nhắc việc -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Nhắc việc và cảnh báo" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReminderRow}">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Content="Nhắc khi quá hạn, lặp lại mỗi" IsChecked="{Binding RemindWhenOverdue}"/>
                                <TextBox Width="50" Margin="8,0" Text="{Binding OverdueRepeatHours}" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="giờ" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Content="Nhắc đôn đốc công việc chờ phản hồi khi đến ngày dự kiến phản hồi (mỗi ngày một lần)" IsChecked="{Binding RemindFollowUp}"/>
                            <CheckBox Content="Hiển thị thông báo Windows" IsChecked="{Binding WindowsNotification}"/>
                            <CheckBox Content="Khi đóng cửa sổ, thu nhỏ xuống khay hệ thống để tiếp tục nhắc việc" IsChecked="{Binding MinimizeToTray}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Mỗi mốc chỉ nhắc một lần. Khi mở lại phần mềm sau thời gian tắt, chỉ mốc gần hạn nhất được nhắc để tránh dồn thông báo."/>
                        </StackPanel>
                    </Border>

                    <!-- Ưu tiên / lập lịch -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Ưu tiên, lập lịch và giao diện" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Thời lượng ước tính mặc định khi chưa nhập (giờ):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding DefaultEstimateHours}" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Chỉ dùng để gợi ý lịch; luôn được đánh dấu là ước tính, không dùng để khẳng định kịp hạn."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Coi là &quot;sắp đến hạn&quot; khi còn (ngày):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="60" Text="{Binding DueSoonDays}" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Content="Giao diện tối" IsChecked="{Binding DarkTheme}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Đồng bộ -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Sem.BlueSoft}">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <TextBlock Text="Đồng bộ dữ liệu giữa các máy" Style="{StaticResource H2}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5"
                                       Text="Dùng chung một thư mục OneDrive/SharePoint của EEMC cho tất cả các máy bạn cài phần mềm. Mỗi máy vẫn làm việc offline bình thường; thay đổi được gửi và nhận tự động khi OneDrive đồng bộ."/>
                            <CheckBox Content="Bật đồng bộ trên máy này" IsChecked="{Binding SyncEnabled}" Margin="0,12,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="Thư mục đồng bộ (giống nhau trên mọi máy)" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Chọn..." Margin="6,0,0,0" Command="{Binding BrowseSyncFolderCommand}"/>
                                <Button DockPanel.Dock="Right" Content="OneDrive EEMC" Tag="&#xE753;" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                        Command="{Binding UseOneDriveCommand}" ToolTip="{Binding SuggestedSyncFolder}"/>
                                <TextBox Text="{Binding SyncFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Tự đồng bộ mỗi" VerticalAlignment="Center"/>
                                <TextBox Width="50" Margin="8,0" Text="{Binding SyncIntervalMinutes}" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="phút (và vài giây sau mỗi thay đổi)" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Đồng bộ ngay" Tag="&#xE895;" Style="{StaticResource PrimaryToolButton}" Command="{Binding SyncNowCommand}"/>
                                <TextBlock Text="{Binding SyncStatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </DockPanel>
                            <TextBlock Text="Các máy đang dùng chung" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastSeenText}" Style="{StaticResource Muted}"/>
                                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Fg.Secondary}"/>
                                            <TextBlock>
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding UserName, Mode=OneWay}" Foreground="{DynamicResource Fg.Secondary}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ThisDeviceText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sao lưu -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sao lưu và phục hồi dữ liệu" Style="{StaticResource H2}"/>
                            <TextBlock Text="Thư mục sao lưu" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Mở" Margin="4,0,0,0" Command="{Binding OpenBackupFolderCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Chọn..." Margin="4,0,0,0" Command="{Binding BrowseBackupFolderCommand}"/>
                                <TextBox Text="{Binding BackupFolder}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Tự động sao lưu mỗi ngày khi mở phần mềm, giữ lại" IsChecked="{Binding AutoBackupDaily}"/>
                                <TextBox Width="50" Margin="8,0" Text="{Binding BackupKeepCount}" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="bản" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                <Button Content="Sao lưu ngay" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" Margin="0,0,8,0"/>
                                <Button Content="Phục hồi bản đã chọn" Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,0"/>
                                <Button Content="Phục hồi từ tệp..." Command="{Binding RestoreFromFileCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Height="170"
                                     BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Muted}" Margin="12,0,4,0"/>
                                            <TextBlock Text="{Binding FileName}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Khi phục hồi, phần mềm tự sao lưu dữ liệu hiện tại (tệp có hậu tố -truoc-phuc-hoi) rồi mới ghi đè. Nên chọn thư mục sao lưu trên ổ đĩa khác hoặc ổ mạng."/>
                            <TextBlock Text="Vị trí dữ liệu" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DatabaseFile}" TextWrapping="Wrap" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Mở thư mục dữ liệu" Style="{StaticResource SmallButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,0"/>
                                <Button Content="Mở nhật ký lỗi" Style="{StaticResource SmallButton}" Command="{Binding OpenLogFolderCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Danh mục -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Danh mục nhóm công việc nghiệp vụ" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding CategoryRows}" SelectedItem="{Binding SelectedCategory}" Height="260"
                                     BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                        <TextBlock Text="{Binding Display}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Tên nhóm / mục" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Thêm nhóm mới" Margin="0,0,6,6" Command="{Binding AddGroupCommand}"/>
                                <Button Content="Thêm mục vào nhóm đang chọn" Margin="0,0,6,6" Command="{Binding AddItemCommand}"/>
                                <Button Content="Đổi tên" Margin="0,0,6,6" Command="{Binding RenameCategoryCommand}"/>
                                <Button Content="Ngừng sử dụng" Margin="0,0,6,6" Command="{Binding DeactivateCategoryCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Phím tắt" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12.5" LineHeight="20"
                                       Text="Ctrl+N: thêm công việc • Ctrl+Enter / Ctrl+S: lưu công việc • Esc: đóng cửa sổ nhập • Ctrl+F: tìm kiếm • Ctrl+1/2/3/4/6/8: Tổng quan / Hôm nay / Tất cả công việc / Lịch / Hồ sơ / Cài đặt • Enter trên danh sách: mở • Delete: chuyển vào thùng rác"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
