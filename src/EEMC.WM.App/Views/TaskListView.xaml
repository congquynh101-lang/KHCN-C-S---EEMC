<UserControl x:Class="EEMC.WM.App.Views.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EEMC.WM.App.ViewModels">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
        </DockPanel>

        <!-- Bộ lọc -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
            <WrapPanel>
                <TextBox Width="240" Margin="0,0,8,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tìm theo nội dung, mã, dự án, số văn bản, người giao, ghi chú (không cần dấu)"/>
                <ComboBox Width="230" Margin="0,0,8,6" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding SelectedStatus}" ToolTip="Trạng thái"/>
                <ComboBox Width="160" Margin="0,0,8,6" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding SelectedPriority}" ToolTip="Mức ưu tiên"/>
                <ComboBox Width="190" Margin="0,0,8,6" ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding SelectedTime}" ToolTip="Thời gian"/>
                <ComboBox Width="250" Margin="0,0,8,6" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding SelectedGroup}" ToolTip="Nhóm nghiệp vụ"/>
                <Button Content="Bỏ lọc" Tag="&#xE894;" Style="{StaticResource ToolButton}" Margin="0,0,16,6" Command="{Binding ClearFiltersCommand}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Sắp xếp:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
                    <ComboBox Width="200" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}"/>
                    <CheckBox Content="Giảm dần" Margin="6,0,12,0" IsChecked="{Binding SortDescending}"/>
                    <TextBlock Text="rồi theo:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
                    <ComboBox Width="170" ItemsSource="{Binding ThenSortChoices}" SelectedItem="{Binding SelectedThenSort}"/>
                    <CheckBox Content="Giảm dần" Margin="6,0,0,0" IsChecked="{Binding ThenSortDescending}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Thanh công cụ -->
        <DockPanel Grid.Row="2" Margin="0,10,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Xuất Excel" Tag="&#xE896;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}"/>
                <Button Command="{Binding ToggleTrashCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}"><Setter Property="Tag" Value="&#xE74D;"/>
                            <Setter Property="Content" Value="{Binding TrashCount}"/>
                            <Setter Property="ContentStringFormat" Value="Thùng rác ({0})"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrash}" Value="True">
                                    <Setter Property="Content" Value="Quay lại danh sách"/><Setter Property="Tag" Value="&#xE72B;"/>
                                    <Setter Property="ContentStringFormat" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTrash, Converter={StaticResource BoolVisInv}}">
                <Button Content="Thêm" Tag="&#xE710;" Style="{StaticResource PrimaryToolButton}" Margin="0,0,8,0" Command="{Binding AddCommand}"/>
                <Button Content="Sửa" Tag="&#xE70F;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding EditCommand}" ToolTip="Hoặc nhấp đúp / Enter"/>
                <Button Content="Sao chép" Tag="&#xE8C8;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding DuplicateCommand}"/>
                <Button Content="Hoàn thành" Tag="&#xE73E;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding CompleteCommand}" Foreground="{DynamicResource Sem.Green}"/>
                <Button Content="Xóa" Tag="&#xE74D;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding DeleteCommand}" ToolTip="Chuyển vào thùng rác (Delete)" Foreground="{DynamicResource Sem.Red}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTrash, Converter={StaticResource BoolVis}}">
                <Button Content="Khôi phục" Tag="&#xE7A7;" Style="{StaticResource PrimaryToolButton}" Margin="0,0,8,0" Command="{Binding RestoreCommand}"/>
                <Button Content="Xóa vĩnh viễn" Tag="&#xE74D;" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Command="{Binding PurgeCommand}" Foreground="{DynamicResource Sem.Red}"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="TaskGrid" Grid.Row="3" ItemsSource="{Binding Items}" SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnGridKeyDown" CanUserSortColumns="False"
                  CanUserReorderColumns="True" CanUserResizeColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Explanation}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Sem.Red}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="SizeToCells" MinWidth="120"/>
                <DataGridTemplateColumn Header="Nội dung công việc" Width="3*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Hạn hoàn thành" Binding="{Binding DueText}" Width="SizeToCells" MinWidth="130"/>
                <DataGridTemplateColumn Header="Còn lại" Width="SizeToCells" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding DueColor, Converter={StaticResource Sem}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ưu tiên" Width="SizeToCells" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PriorityBadge}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Trạng thái" Width="SizeToCells" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tiến độ" Binding="{Binding ProgressText}" Width="SizeToHeader"/>
                <DataGridTextColumn Header="Nhóm công việc" Binding="{Binding CategoryText}" Width="1.3*" MinWidth="120"/>
                <DataGridTextColumn Header="Đề tài/Dự án" Binding="{Binding ProjectName}" Width="1*" MinWidth="100"/>
                <DataGridTextColumn Header="Người giao" Binding="{Binding AssignedBy}" Width="0.8*" MinWidth="90"/>
                <DataGridTextColumn Header="Ngày nhận" Binding="{Binding ReceivedText}" Width="SizeToCells" MinWidth="130"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Mở / sửa" Command="{Binding EditCommand}"/>
                    <MenuItem Header="Sao chép công việc" Command="{Binding DuplicateCommand}"/>
                    <MenuItem Header="Ghi nhận hoàn thành" Command="{Binding CompleteCommand}"/>
                    <Separator/>
                    <MenuItem Header="Chuyển vào thùng rác" Command="{Binding DeleteCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Phân trang -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Số dòng/trang:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
                <ComboBox Width="80" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="«" Style="{StaticResource SmallButton}" Command="{Binding FirstPageCommand}" Margin="0,0,4,0"/>
                <Button Content="‹ Trước" Style="{StaticResource SmallButton}" Command="{Binding PrevPageCommand}" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Trang"/>
                    <Run Text="{Binding Page, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="/"/>
                    <Run Text="{Binding PageCount, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="Sau ›" Style="{StaticResource SmallButton}" Command="{Binding NextPageCommand}" Margin="8,0,4,0"/>
                <Button Content="»" Style="{StaticResource SmallButton}" Command="{Binding LastPageCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
