<UserControl x:Class="EEMC.WM.App.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" MaxWidth="700"/>
            <TextBlock Text="Hồ sơ tài liệu" Style="{StaticResource H1}"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <WrapPanel>
                <TextBox Width="320" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tên công việc, dự án, số văn bản, từ khóa">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchNowCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Tìm" Margin="0,0,12,0" Command="{Binding SearchNowCommand}"/>
                <ComboBox Width="200" Margin="0,0,12,0" ItemsSource="{Binding DocumentChoices}" SelectedItem="{Binding SelectedDocument}"/>
                <CheckBox Content="Gồm cả công việc đã hoàn thành/hủy" IsChecked="{Binding IncludeClosed}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding Item.Code}" Width="118"/>
                <DataGridTextColumn Header="Công việc" Binding="{Binding Item.Title}" Width="2*"/>
                <DataGridTextColumn Header="Đề tài/Dự án" Binding="{Binding Item.ProjectName}" Width="*"/>
                <DataGridTextColumn Header="Số văn bản" Binding="{Binding DocumentNumber}" Width="130"/>
                <DataGridTextColumn Header="Tình trạng hồ sơ" Binding="{Binding DocumentStatusText}" Width="130"/>
                <DataGridTextColumn Header="Trạng thái CV" Binding="{Binding Item.StatusText}" Width="150"/>
                <DataGridTextColumn Header="Đường dẫn" Binding="{Binding FolderPath}" Width="1.5*"/>
                <DataGridTemplateColumn Header="" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mở hồ sơ" Style="{StaticResource SmallButton}" Margin="0,0,4,0"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Visibility="{Binding FolderPath, Converter={StaticResource BoolVis}}"/>
                                <Button Content="Sửa" Style="{StaticResource SmallButton}" Command="{Binding Item.EditCommand}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
