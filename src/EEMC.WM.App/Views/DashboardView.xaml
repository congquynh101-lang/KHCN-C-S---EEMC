<UserControl x:Class="EEMC.WM.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EEMC.WM.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Greeting}" Style="{StaticResource Muted}" FontSize="13"/>
                <TextBlock Text="Tổng quan điều hành công việc" Style="{StaticResource H1}"/>
            </StackPanel>

            <!-- KPI -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KpiTile}">
                        <Button Command="{Binding OpenCommand}" Margin="0,0,14,14" Padding="18,16" HorizontalContentAlignment="Stretch"
                                ToolTip="{Binding Hint}" Background="{DynamicResource Bg.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{Binding Color, Converter={StaticResource SemSoft}}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Color, Converter={StaticResource Sem}}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg.Primary}" LineHeight="32" LineStackingStrategy="BlockLineHeight"/>
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Fg.Secondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource Fg.Tertiary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- 5 việc ưu tiên -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Xem toàn bộ thứ tự xử lý →" Style="{StaticResource GhostButton}" Command="{Binding OpenTodayCommand}"/>
                            <TextBlock Text="5 CÔNG VIỆC CẦN ƯU TIÊN XỬ LÝ HÔM NAY" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TopFive}" ItemTemplate="{StaticResource TaskCard}"/>
                        <StackPanel Visibility="{Binding TopFive.Count, Converter={StaticResource BoolVisInv}}" Margin="0,8">
                            <TextBlock Text="Không có công việc nào đang chờ bạn trực tiếp xử lý." Style="{StaticResource Muted}" FontSize="13"/>
                            <Button Content="＋ Thêm công việc đầu tiên" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding AddTaskCommand}" Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Biểu đồ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tỷ lệ hoàn thành đúng hạn" Style="{StaticResource H2}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OnTimeText}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource Sem.Green}"/>
                                <StackPanel Margin="16,4,0,0">
                                    <TextBlock Text="Thời gian xử lý trung bình" Style="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding LeadTimeText}" FontSize="16" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding OnTimeDetail}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Công việc chưa hoàn thành theo trạng thái" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding ByStatus}" ItemTemplate="{StaticResource BarRow}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Công việc chưa hoàn thành theo nhóm nghiệp vụ" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding ByCategory}" ItemTemplate="{StaticResource BarRow}"/>
                            <TextBlock Text="Chưa có dữ liệu." Style="{StaticResource Muted}"
                                       Visibility="{Binding ByCategory.Count, Converter={StaticResource BoolVisInv}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Theo tuần -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Rectangle Width="12" Height="12" Fill="{DynamicResource Sem.Blue}" Margin="0,0,4,0"/>
                            <TextBlock Text="Tiếp nhận" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                            <Rectangle Width="12" Height="12" Fill="{DynamicResource Sem.Green}" Margin="0,0,4,0"/>
                            <TextBlock Text="Hoàn thành" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                            <Rectangle Width="12" Height="3" Fill="{DynamicResource Sem.Orange}" Margin="0,0,4,0"/>
                            <TextBlock Text="Tồn đọng cuối tuần" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <TextBlock Text="Công việc nhận – hoàn thành – tồn đọng theo tuần (8 tuần gần nhất)" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Weekly}" Height="190">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WeekBar}">
                                <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Backlog, StringFormat=Tồn {0:0}}" HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource Sem.Orange}"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                            <TextBlock Text="{Binding Received}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Fg.Secondary}"/>
                                            <Border Width="18" Background="{DynamicResource Sem.Blue}" CornerRadius="2,2,0,0">
                                                <Border.Height>
                                                    <MultiBinding Converter="{StaticResource BarWidth}" ConverterParameter="120">
                                                        <Binding Path="Received"/>
                                                        <Binding Path="Max"/>
                                                    </MultiBinding>
                                                </Border.Height>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                                            <TextBlock Text="{Binding Completed}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Fg.Secondary}"/>
                                            <Border Width="18" Background="{DynamicResource Sem.Green}" CornerRadius="2,2,0,0">
                                                <Border.Height>
                                                    <MultiBinding Converter="{StaticResource BarWidth}" ConverterParameter="120">
                                                        <Binding Path="Completed"/>
                                                        <Binding Path="Max"/>
                                                    </MultiBinding>
                                                </Border.Height>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Fg.Secondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
