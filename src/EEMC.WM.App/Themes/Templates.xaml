<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:inf="clr-namespace:EEMC.WM.App.Infrastructure"
                    xmlns:vm="clr-namespace:EEMC.WM.App.ViewModels">

    <inf:SemanticBrushConverter x:Key="T.Sem"/>
    <inf:SemanticBrushConverter x:Key="T.SemSoft" Suffix="Soft"/>
    <inf:BoolToVisibilityConverter x:Key="T.BoolVis"/>
    <inf:BarWidthConverter x:Key="BarWidthLocal"/>

    <!-- Nhãn ưu tiên -->
    <DataTemplate x:Key="PriorityBadge" DataType="{x:Type vm:TaskItemViewModel}">
        <Border Style="{DynamicResource Badge}" Background="{Binding PriorityColor, Converter={StaticResource T.SemSoft}}">
            <TextBlock Text="{Binding PriorityText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PriorityColor, Converter={StaticResource T.Sem}}"/>
        </Border>
    </DataTemplate>

    <!-- Nhãn trạng thái -->
    <DataTemplate x:Key="StatusBadge" DataType="{x:Type vm:TaskItemViewModel}">
        <Border Style="{DynamicResource Badge}" Background="{Binding StatusColor, Converter={StaticResource T.SemSoft}}">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor, Converter={StaticResource T.Sem}}"/>
        </Border>
    </DataTemplate>

    <!-- Menu chuyển trạng thái -->
    <ContextMenu x:Key="StatusMenu" x:Shared="False" ItemsSource="{Binding StatusOptions}">
        <ContextMenu.ItemContainerStyle>
            <Style TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}"/>
                <Setter Property="Command" Value="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Setter Property="CommandParameter" Value="{Binding}"/>
            </Style>
        </ContextMenu.ItemContainerStyle>
    </ContextMenu>

    <!-- Thẻ công việc có nút thao tác (Tổng quan, Hôm nay) -->
    <DataTemplate x:Key="TaskCard" DataType="{x:Type vm:TaskItemViewModel}">
        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                CornerRadius="10" Margin="0,0,0,10" inf:DoubleClick.Command="{Binding EditCommand}" Cursor="Hand"
                ToolTip="Nhấp đúp để mở chi tiết">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{Binding PriorityColor, Converter={StaticResource T.Sem}}" CornerRadius="2" Width="4" Margin="0,12" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Margin="12,10">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Primary}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Code}" Style="{DynamicResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DueText, StringFormat=Hạn: {0}}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Fg.Primary}"/>
                        <TextBlock Text="{Binding RemainingText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{Binding DueColor, Converter={StaticResource T.Sem}}"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PriorityBadge}" Margin="0,0,6,0"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Explanation}" Style="{DynamicResource Muted}" Margin="0,6,0,0"
                               Visibility="{Binding Explanation, Converter={StaticResource T.BoolVis}}"/>
                    <TextBlock Text="{Binding SuggestionText}" FontSize="12" Foreground="{DynamicResource Sem.Orange}" TextWrapping="Wrap"
                               Visibility="{Binding SuggestionText, Converter={StaticResource T.BoolVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="Bắt đầu" Tag="&#xE768;" Style="{DynamicResource ToolButton}" Padding="10,4" MinHeight="28" FontSize="12" Margin="0,0,6,0" Command="{Binding StartCommand}"
                            Visibility="{Binding CanStart, Converter={StaticResource T.BoolVis}}" ToolTip="Chuyển sang Đang thực hiện"/>
                    <Button Content="Hoàn thành" Tag="&#xE73E;" Style="{DynamicResource ToolButton}" Padding="10,4" MinHeight="28" FontSize="12" Margin="0,0,6,0" Command="{Binding CompleteCommand}"
                            Foreground="{DynamicResource Sem.Green}" ToolTip="Ghi nhận hoàn thành (cần xác nhận)"/>
                    <Button Content="&#xE712;" Style="{DynamicResource IconButton}" Width="30" Height="28" Margin="0,0,2,0" ToolTip="Chuyển trạng thái"
                            inf:DropDownMenu.Enabled="True" ContextMenu="{StaticResource StatusMenu}"/>
                    <Button Content="&#xE8A7;" Style="{DynamicResource IconButton}" Width="30" Height="28" Command="{Binding EditCommand}" ToolTip="Mở chi tiết"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Dòng công việc gọn (danh sách chờ, cảnh báo) -->
    <DataTemplate x:Key="TaskLine" DataType="{x:Type vm:TaskItemViewModel}">
        <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="0,8" Background="Transparent"
                inf:DoubleClick.Command="{Binding EditCommand}" Cursor="Hand">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE712;" Style="{DynamicResource IconButton}" Width="30" Height="28" Margin="4,0,2,0" ToolTip="Chuyển trạng thái"
                            inf:DropDownMenu.Enabled="True" ContextMenu="{StaticResource StatusMenu}"/>
                    <Button Content="&#xE8A7;" Style="{DynamicResource IconButton}" Width="30" Height="28" Command="{Binding EditCommand}" ToolTip="Mở chi tiết"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                    <WrapPanel Margin="0,3,0,0">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DueText, StringFormat=Hạn {0}}" Style="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ExpectedResponseText, StringFormat=• Dự kiến phản hồi {0}}" Style="{DynamicResource Muted}" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Visibility="{Binding ExpectedResponseText, Converter={StaticResource T.BoolVis}}"/>
                        <TextBlock Text="{Binding Coordinator, StringFormat=• {0}}" Style="{DynamicResource Muted}" VerticalAlignment="Center"
                                   Visibility="{Binding Coordinator, Converter={StaticResource T.BoolVis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Explanation}" Style="{DynamicResource Muted}" Margin="0,3,0,0"
                               Visibility="{Binding Explanation, Converter={StaticResource T.BoolVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Thanh biểu đồ ngang -->
    <DataTemplate x:Key="BarRow" DataType="{x:Type vm:BarItem}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Height="14" CornerRadius="3" HorizontalAlignment="Left" Margin="6,0"
                    Background="{Binding Color, Converter={StaticResource T.Sem}}">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource BarWidthLocal}" ConverterParameter="200">
                        <Binding Path="Value"/>
                        <Binding Path="Max"/>
                    </MultiBinding>
                </Border.Width>
            </Border>
            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
