@inject UiService UiSvc
@inject TaskService Tasks

<div class="rel" style="display:inline-block">
    <button class="btn sm ghost icon-only" @onclick="() => _open = !_open" title="Chuyển trạng thái"><Icon Name="more" Class="sm" /></button>
    @if (_open)
    {
        <div class="overlay" style="background:transparent;padding:0" @onclick="() => _open = false"></div>
        <div class="menu" style="z-index:110">
            @foreach (var s in Enum.GetValues<WorkTaskStatus>())
            {
                <button @onclick="() => Set(s)" disabled="@(s == Item.Status)">
                    <span class="dot bg-@Ui.StatusColor(s)"></span>&nbsp; @Labels.Of(s)
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public WorkTask Item { get; set; } = default!;
    private bool _open;

    private async Task Set(WorkTaskStatus s)
    {
        _open = false;
        if (s == Item.Status) return;
        if (s == WorkTaskStatus.Completed && !await UiSvc.ConfirmAsync($"Xác nhận HOÀN THÀNH công việc?\n[{Item.Code}] {Item.Title}", "Hoàn thành")) return;
        if (s == WorkTaskStatus.Cancelled && !await UiSvc.ConfirmAsync($"Xác nhận HỦY công việc?\n[{Item.Code}] {Item.Title}", "Hủy công việc", danger: true)) return;
        try
        {
            await Tasks.ChangeStatusAsync(Item.Id, s);
            UiSvc.Success($"{Item.Code}: {Labels.Of(s)}");
        }
        catch (Exception ex) { UiSvc.Error(ex, "Không đổi được trạng thái"); }
    }
}
