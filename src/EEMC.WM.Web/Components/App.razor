<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f6cbd" />
    <base href="/" />
    <title>KHCN&amp;CĐS EEMC</title>
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="favicon.png" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="stylesheet" href="@Versioned("app.css")" />
    <link rel="stylesheet" href="@Versioned("EEMC.WM.Web.styles.css")" />
    <script src="@Versioned("app.js")"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="blazor-error-ui">
        Mất kết nối hoặc có lỗi. <a href="" class="reload">Tải lại trang</a>
        <a class="dismiss">✕</a>
    </div>
    @if (PageRenderMode != null)
    {
        @* Trang đăng nhập/tạo tài khoản là trang tĩnh, không cần (và chưa được phép tải) tệp này *@
        <script src="_framework/blazor.web.js"></script>
    }
</body>

</html>

@inject IWebHostEnvironment Env

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Gắn dấu phiên bản theo thời điểm sửa tệp để trình duyệt tải lại CSS/JS sau mỗi lần cập nhật
    private string Versioned(string path)
    {
        var f = Env.WebRootFileProvider.GetFileInfo(path);
        return f.Exists ? $"{path}?v={f.LastModified.UtcTicks:x}" : path;
    }

    // Trang đăng nhập/tạo tài khoản chạy dạng tĩnh (để ghi cookie); các trang còn lại tương tác qua máy chủ
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments("/account") ? null : InteractiveServer;
}
