@page "/projects"
@inherits LivePage
@inject ProjectService Projects

<PageTitle>Dự án KH&amp;CN – KHCN&amp;CĐS EEMC</PageTitle>
<div class="page-head">
    <h1>Dự án KH&amp;CN</h1>
    <span class="spacer"></span>
    <div class="seg">
        <button class="@(_treeMode ? "" : "on")" @onclick="() => _treeMode = false">Thẻ</button>
        <button class="@(_treeMode ? "on" : "")" @onclick="() => _treeMode = true">Cây</button>
    </div>
    <label class="check small"><input type="checkbox" @bind="_archived" @bind:after="SafeLoadAsync" /> Hiện dự án đã lưu trữ</label>
    @if (CanEdit)
    {
        <button class="btn" @onclick="() => _showTemplates = !_showTemplates"><Icon Name="copy" Class="sm" />Tạo từ mẫu</button>
        <button class="btn primary" @onclick="NewProject"><Icon Name="plus" Class="sm" />Thêm dự án</button>
    }
</div>

@if (_treeMode)
{
    <div class="card mb">
        <div class="row mb-s">
            <span class="muted spacer">Dự án → công việc → việc con, cháu, chắt. Mở nhánh nào mới tải nhánh đó.</span>
            <label class="check small"><input type="checkbox" @bind="_closed" /> Cả việc đã hoàn thành/hủy</label>
        </div>
        <TreeView @key="_closed" @ref="_tree" LoadChildren="LoadTreeAsync" Search="SearchTreeAsync" Placeholder="Tìm dự án, mã hoặc tên công việc..." Empty="Chưa có dự án hoặc công việc.">
            <Actions>
                @if (CanEdit && context.Key.StartsWith("p:"))
                {
                    var pid = context.Data is Project pr ? pr.Id : (int?)null;
                    <button class="btn sm ghost" title="Thêm công việc vào @context.Label" @onclick="() => OpenEditor(projectId: pid)"><Icon Name="plus" Class="sm" /><span class="hide-mobile">Công việc</span></button>
                }
                else if (CanEdit && context.Data is WorkTask t && context.Level <= TaskService.MaxSubtaskDepth)
                {
                    <button class="btn sm ghost" title="Thêm việc con cho @t.Code" @onclick="() => OpenEditor(parentId: t.Id)"><Icon Name="plus" Class="sm" /><span class="hide-mobile">Việc con</span></button>
                }
            </Actions>
        </TreeView>
    </div>
}

@if (_showTemplates)
{
    <div class="card mb">
        <h2>Mẫu dự án nghiệp vụ</h2>
        <div class="muted mb">Mẫu chỉ tạo tên, mô tả và các mốc điển hình (không có ngày). Phần mềm không tự tạo tiến độ, ngày hoàn thành hay trạng thái thực tế.</div>
        <div class="grid grid-3">
            @foreach (var t in ProjectService.Templates)
            {
                <div class="card" style="padding:12px">
                    <b>@t.Name</b>
                    <div class="small muted">@t.ManagementLevel · @t.Milestones.Length mốc</div>
                    <button class="btn sm mt-s" @onclick="() => FromTemplate(t)">Tạo dự án này</button>
                </div>
            }
        </div>
    </div>
}

@if (!_treeMode)
{
@if (_list.Count == 0 && !Loading)
{
    <div class="card empty">Chưa có dự án. Bấm "Thêm dự án" hoặc "Tạo từ mẫu".</div>
}
<div class="grid grid-2">
    @foreach (var s in _list)
    {
        var p = s.Project;
        <div class="card">
            <div class="row nowrap">
                <span class="badge b-@Ui.ProjectStatusColor(p.Status)">@Labels.Of(p.Status)</span>
                <span class="muted small">@p.Code</span>
                <span class="spacer"></span>
                @if (p.IsArchived) { <span class="badge b-gray">Lưu trữ</span> }
            </div>
            <a class="task-title" style="font-size:15px;display:block;margin-top:6px" href="/projects/@p.Id">@p.Name</a>
            <div class="task-meta">
                @if (!string.IsNullOrEmpty(p.ManagementLevel)) { <span>@p.ManagementLevel</span> }
                @if (!string.IsNullOrEmpty(p.Leader)) { <span>Chủ nhiệm: @p.Leader</span> }
                @if (p.StartDate.HasValue || p.EndDate.HasValue) { <span>@Ui.D(p.StartDate) – @Ui.D(p.EndDate)</span> }
            </div>
            <div class="row mt">
                <div class="progress" style="flex:1;height:8px"><div style="width:@(s.Progress ?? 0)%"></div></div>
                <b>@(s.Progress.HasValue ? $"{s.Progress}%" : "—")</b>
            </div>
            <div class="task-meta">
                <span>@s.TaskCount công việc</span>
                <span>@s.OpenCount đang mở</span>
                @if (s.OverdueCount > 0) { <b class="c-red">@s.OverdueCount quá hạn</b> }
                @if (s.NextMilestone != null) { <span><Icon Name="milestone" Class="sm" /> @s.NextMilestone.Name @(s.NextMilestone.DueDate.HasValue ? "(" + Ui.D(s.NextMilestone.DueDate) + ")" : "")</span> }
            </div>
        </div>
    }
</div>
}

@if (_edit != null)
{
    <ProjectEditor Project="_edit" OnClose="() => _edit = null" OnSaved="Saved" />
}

@code {
    private List<ProjectSummary> _list = new();
    private bool _archived, _showTemplates;
    private Project? _edit;

    protected override async Task OnInitializedAsync()
    {
        Projects.Changed += OnProjects;
        await base.OnInitializedAsync();
    }

    private void OnProjects(object? s, EventArgs e) => InvokeAsync(async () => { await SafeLoadAsync(); StateHasChanged(); });

    protected override async Task LoadAsync()
    {
        _list = await Projects.GetSummariesAsync(_archived);
        if (_treeMode && _tree != null) await _tree.ReloadAsync();
    }

    // ---------------------------------------------------------------- Cây Dự án → Công việc

    private bool _treeMode, _closed;
    private TreeView? _tree;

    private async Task<List<TreeNode>> LoadTreeAsync(TreeNode? parent)
    {
        if (parent == null)
        {
            var counts = await Tasks.CountRootTasksByProjectAsync(_closed);
            var nodes = _list.Select(s => new TreeNode
            {
                Key = $"p:{s.Project.Id}", Label = $"{s.Project.Code} – {s.Project.Name}", Href = $"/projects/{s.Project.Id}", Icon = "project",
                Badge = Labels.Of(s.Project.Status), BadgeColor = Ui.ProjectStatusColor(s.Project.Status),
                Meta = s.Progress.HasValue ? $"{s.Progress}%" : null, ChildCount = counts.GetValueOrDefault(s.Project.Id), Data = s.Project
            }).ToList();
            if (counts.GetValueOrDefault(0) > 0)
                nodes.Add(new TreeNode { Key = "p:0", Label = "Công việc không thuộc dự án", Icon = "folder", ChildCount = counts[0] });
            return nodes;
        }
        var level = parent.Data is WorkTask t
            ? await Tasks.GetTreeLevelAsync(null, t.Id, _closed)
            : await Tasks.GetTreeLevelAsync((parent.Data as Project)?.Id, null, _closed);
        return level.Select(x => new TreeNode
        {
            Key = $"t:{x.Task.Id}", Label = $"{x.Task.Code} · {x.Task.Title}", Href = $"/tasks/{x.Task.Id}",
            Badge = Labels.Of(x.Task.Status), BadgeColor = Ui.StatusColor(x.Task.Status),
            Meta = Ui.Remaining(x.Task, Now), MetaColor = Ui.DueColor(x.Task, Now), ChildCount = x.ChildCount, Data = x.Task
        }).ToList();
    }

    /// <summary>Đường dẫn từ dự án tới từng kết quả: [dự án, công việc gốc, ..., công việc khớp].</summary>
    private async Task<List<IReadOnlyList<string>>> SearchTreeAsync(string q)
    {
        var terms = TextNormalizer.Normalize(q).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var paths = new List<IReadOnlyList<string>>();
        foreach (var s in _list.Where(s => terms.All(TextNormalizer.Normalize(s.Project.Code + " " + s.Project.Name).Contains)))
            paths.Add(new[] { $"p:{s.Project.Id}" });
        foreach (var t in (await Tasks.SearchQuickAsync(q, 20)).Where(t => _closed || !StatusGroups.IsClosed(t.Status)))
        {
            var ancestors = await Tasks.GetAncestorsAsync(t.Id);
            var path = new List<string> { $"p:{(ancestors.FirstOrDefault() ?? t).ProjectId ?? 0}" };
            path.AddRange(ancestors.Select(a => $"t:{a.Id}"));
            path.Add($"t:{t.Id}");
            paths.Add(path);
        }
        return paths;
    }

    private void NewProject() => _edit = new Project();

    private async Task FromTemplate(ProjectTemplate t)
    {
        try
        {
            var p = await Projects.CreateFromTemplateAsync(t);
            UiSvc.Success($"Đã tạo {p.Code}. Hãy cập nhật cấp quản lý, chủ nhiệm, thời gian thực hiện.");
            Nav.NavigateTo($"/projects/{p.Id}");
        }
        catch (Exception ex) { UiSvc.Error(ex, "Không tạo được dự án"); }
    }

    private void Saved(Project p)
    {
        _edit = null;
        Nav.NavigateTo($"/projects/{p.Id}");
    }

    public override void Dispose()
    {
        Projects.Changed -= OnProjects;
        base.Dispose();
    }
}
