@page "/account/setup"
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@inject UserService Users
@inject NavigationManager Nav

<PageTitle>Tạo tài khoản – KHCN&amp;CĐS EEMC</PageTitle>
<h1 style="font-size:20px">Thiết lập lần đầu</h1>
<p class="muted">Tạo tài khoản quản trị để đăng nhập. Trang này chỉ dùng được một lần khi chưa có tài khoản nào.</p>

<EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="setup">
    <label class="field"><span>Họ tên hiển thị</span>
        <InputText @bind-Value="Input.DisplayName" class="input" autofocus />
    </label>
    <label class="field"><span>Tên đăng nhập (chữ không dấu, số)</span>
        <InputText @bind-Value="Input.UserName" class="input" autocomplete="username" />
    </label>
    <label class="field"><span>Mật khẩu (tối thiểu 10 ký tự, có chữ và số)</span>
        <InputText type="password" @bind-Value="Input.Password" class="input" autocomplete="new-password" />
    </label>
    <label class="field"><span>Nhập lại mật khẩu</span>
        <InputText type="password" @bind-Value="Input.Confirm" class="input" autocomplete="new-password" />
    </label>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="validation">@_error</div>
    }
    <button type="submit" class="btn primary mt" style="width:100%;min-height:38px">Tạo tài khoản và đăng nhập</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private SetupInput Input { get; set; } = new();
    private string? _error;

    public sealed class SetupInput
    {
        public string DisplayName { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        if (await Users.HasAnyUserAsync()) Nav.NavigateTo("/account/login");
    }

    private async Task CreateAsync()
    {
        if (Input.Password != Input.Confirm) { _error = "Hai lần nhập mật khẩu không khớp."; return; }
        AppUser user;
        try
        {
            user = await Users.CreateFirstAdminAsync(Input.UserName, Input.DisplayName, Input.Password);
        }
        catch (ValidationException ex) { _error = string.Join("\n", ex.Errors); return; }
        catch (InvalidOperationException ex) { _error = ex.Message; return; }
        await Login.SignInAsync(HttpContext, user, persistent: true);
        Nav.NavigateTo("/");
    }
}
